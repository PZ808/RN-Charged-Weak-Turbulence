          RowBox[{"{", 
           RowBox[{"\[Delta]L", ",", "\[Delta]M"}], "}"}]}], "}"}], "]"}], "=", 
       RowBox[{"computeQLM", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Alpha]L", ",", "\[Alpha]M"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Beta]L", ",", "\[Beta]M"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Gamma]L", ",", "\[Gamma]M"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Delta]L", ",", "\[Delta]M"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]L", ",", "0", ",", "LL"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]M", ",", 
        RowBox[{"-", "\[Alpha]L"}], ",", "\[Alpha]L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]L", ",", "0", ",", "LL"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]M", ",", 
        RowBox[{"-", "\[Beta]L"}], ",", "\[Beta]L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]L", ",", "0", ",", "LL"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]M", ",", 
        RowBox[{"-", "\[Gamma]L"}], ",", "\[Gamma]L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]L", ",", "0", ",", "LL"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]M", ",", 
        RowBox[{"-", "\[Delta]L"}], ",", "\[Delta]L"}], "}"}]}], "]"}], ";"}],
    "  ", "*)"}]}], "\[IndentingNewLine]"}], "Input",
