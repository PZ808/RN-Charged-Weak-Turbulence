Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"toCOO", ",", "exportSparseAssociationsHDF5"}], "]"}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"toCOO", "[", 
     RowBox[{"assoc_Association", ",", 
      RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nz", ",", "keys", ",", "vals"}], "}"}], ",", 
      RowBox[{
       RowBox[{"nz", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"assoc", ",", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"#", "==", "0"}], "]"}]}], "&"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"keys", "=", 
        RowBox[{"Developer`ToPackedArray", "[", 
         RowBox[{"Flatten", "/@", 
          RowBox[{"Keys", "[", "nz", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"vals", "=", 
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"Values", "[", "nz", "]"}], ",", "wp"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<keys\>\"", "->", "keys"}], ",", 
         RowBox[{"\"\<values_re\>\"", "->", 
          RowBox[{"Developer`ToPackedArray", "[", 
           RowBox[{"Re", "[", "vals", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<values_im\>\"", "->", 
          RowBox[{"Developer`ToPackedArray", "[", 
           RowBox[{"Im", "[", "vals", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<key_shape\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"4", ",", "2"}], "}"}]}], ",", 
         RowBox[{"\"\<nnz\>\"", "->", 
          RowBox[{"Length", "[", "nz", "]"}]}], ",", 
         RowBox[{"\"\<original_length\>\"", "->", 
          RowBox[{"Length", "[", "assoc", "]"}]}]}], "|>"}]}]}], "]"}]}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exportSparseAssociationsHDF5", "[", 
    RowBox[{"file_", ",", "namedAssocs_Association", ",", 
     RowBox[{"wp_", ":", "MachinePrecision"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"coos", ",", "datasets", ",", "names"}], "}"}], ",", 
     RowBox[{
      RowBox[{"coos", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"toCOO", "[", 
          RowBox[{"#", ",", "wp"}], "]"}], "&"}], "/@", "namedAssocs"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"datasets", "=", 
       RowBox[{"Flatten", "@", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"name", ",", "coo"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"\"\</\>\"", "<>", "name", "<>", "\"\</keys\>\""}], "->", 
               RowBox[{"coo", "[", "\"\<keys\>\"", "]"}]}], ",", 
              RowBox[{
               
               RowBox[{"\"\</\>\"", "<>", "name", 
                "<>", "\"\</values_re\>\""}], "->", 
               RowBox[{"coo", "[", "\"\<values_re\>\"", "]"}]}], ",", 
              RowBox[{
               
               RowBox[{"\"\</\>\"", "<>", "name", 
                "<>", "\"\</values_im\>\""}], "->", 
               RowBox[{"coo", "[", "\"\<values_im\>\"", "]"}]}], ",", 
              RowBox[{
               
               RowBox[{"\"\</\>\"", "<>", "name", 
                "<>", "\"\</key_shape\>\""}], "->", 
               RowBox[{"coo", "[", "\"\<key_shape\>\"", "]"}]}], ",", 
              RowBox[{
               RowBox[{"\"\</\>\"", "<>", "name", "<>", "\"\</nnz\>\""}], "->", 
               RowBox[{"{", 
                RowBox[{"coo", "[", "\"\<nnz\>\"", "]"}], "}"}]}], ",", 
              RowBox[{
               
               RowBox[{"\"\</\>\"", "<>", "name", 
                "<>", "\"\</original_length\>\""}], "->", 
               RowBox[{"{", 
                RowBox[{"coo", "[", "\"\<original_length\>\"", "]"}], 
                "}"}]}]}], "}"}]}], "]"}], ",", "coos"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Export", "[", 
       RowBox[{"file", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Datasets\>\"", "->", "datasets"}], "}"}], 
        ",", "\"\<Rules\>\""}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.987591019290148*^9, 3.987591019292658*^9}},
 CellLabel->
