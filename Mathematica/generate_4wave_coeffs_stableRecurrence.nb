Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"precomputedQ12b3b4", "=", 
    RowBox[{"Association", "[", "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "generate", " ", "key", " ", "value", " ", "pairs", " ", "for", " ", "the",
     " ", 
    SubsuperscriptBox["Q", "34", "12"], " ", "functions"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"computeQNLM", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\[Alpha]L_", ",", "\[Alpha]M_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Beta]L_", ",", "\[Beta]M_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]L_", ",", "\[Gamma]M_"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Delta]L_", ",", "\[Delta]M_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"GenerateCanonQ12b3b4", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]L", ",", "\[Alpha]M"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]L", ",", "\[Beta]M"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]L", ",", "\[Gamma]M"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]L", ",", "\[Delta]M"}], "}"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Populate", " ", "the", " ", "association", " ", "with", " ", 
    "precomputed", " ", "values"}], "*)"}], " ", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "generate", " ", "all", " ", "symmetric", " ", 
    "equivalents", " ", "for", " ", "Q"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"GenerateSymmetricEquivalentsQ", "[", "indices_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4", 
        ",", "firstPair", ",", "secondPair", ",", "permutations"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", 
          "\[Lambda]4"}], "}"}], "=", "indices"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Symmetric", " ", "swaps", " ", "within", " ", "first", " ", "two", " ",
          "and", " ", "last", " ", "two", " ", "indices"}], "*)"}], 
       RowBox[{"firstPair", "=", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]1", ",", "\[Lambda]2"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"secondPair", "=", 
        RowBox[{"{", 
         RowBox[{"\[Lambda]3", ",", "\[Lambda]4"}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Generate", " ", "all", " ", "symmetric", " ", "combinations"}], 
        "*)"}], 
       RowBox[{"permutations", "=", 
        RowBox[{"Tuples", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Permutations", "[", "firstPair", "]"}], ",", 
           RowBox[{"Permutations", "[", "secondPair", "]"}]}], "}"}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Flatten", " ", "the", " ", "results"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"#", ",", "1"}], "]"}], "&"}], "/@", "permutations"}]}]}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"precomputedQLM", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Alpha]L", ",", "\[Alpha]M"}], "}"}], ",", 
          RowBox[{"{", 
