Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{"(*", 
   RowBox[{
   "Modified", " ", "Do", " ", "loop", " ", "for", " ", "Q", " ", "with", " ",
     "symmetry", " ", "handling"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GenerateQassoc", "[", 
      RowBox[{
      "\[Alpha]Lmax_", ",", "\[Beta]Lmax_", ",", "\[Gamma]Lmax_", ",", 
       "\[Delta]Lmax_"}], "]"}], ":=", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "currentIndices", ",", "symmetricEquivalents", ",", 
           "foundEquivalent", ",", "value"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{"Current", " ", "indices"}], "*)"}], 
         RowBox[{
          RowBox[{"currentIndices", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\[Alpha]L", ",", "\[Alpha]M"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Beta]L", ",", "\[Beta]M"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Gamma]L", ",", "\[Gamma]M"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Delta]L", ",", "\[Delta]M"}], "}"}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Generate", " ", "all", " ", "symmetric", " ", "equivalents"}], 
           "*)"}], 
          RowBox[{"symmetricEquivalents", "=", 
           RowBox[{
           "GenerateSymmetricEquivalentsQ", "[", "currentIndices", "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Check", " ", "if", " ", "any", " ", "symmetric", " ", 
            "equivalent", " ", "is", " ", "already", " ", "computed"}], 
           "*)"}], 
          RowBox[{"foundEquivalent", "=", 
           RowBox[{"SelectFirst", "[", 
            RowBox[{"symmetricEquivalents", ",", 
             RowBox[{
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"precomputedQ12b3b4", ",", "#"}], "]"}], "&"}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"foundEquivalent", "=!=", 
             RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "If", " ", "an", " ", "equivalent", " ", "is", " ", "found"}], ",", 
              RowBox[{"copy", " ", "its", " ", "value"}]}], "*)"}], 
            RowBox[{
             RowBox[{"precomputedQ12b3b4", "[", "currentIndices", "]"}], "=", 
             
             RowBox[{"precomputedQ12b3b4", "[", "foundEquivalent", "]"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{"Otherwise", ",", 
              RowBox[{
              "compute", " ", "and", " ", "store", " ", "the", " ", 
               "value"}]}], "*)"}], 
            RowBox[{
             RowBox[{"precomputedQ12b3b4", "[", "currentIndices", "]"}], "=", 
             
             RowBox[{"computeQNLM", "@@", "currentIndices"}]}]}], "]"}], 
          ";"}]}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]L", ",", "0", ",", "\[Alpha]Lmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Alpha]M", ",", 
         RowBox[{"-", "\[Alpha]L"}], ",", "\[Alpha]L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Beta]L", ",", "0", ",", "\[Beta]Lmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Beta]M", ",", 
         RowBox[{"-", "\[Beta]L"}], ",", "\[Beta]L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Gamma]L", ",", "0", ",", "\[Gamma]Lmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Gamma]M", ",", 
         RowBox[{"-", "\[Gamma]L"}], ",", "\[Gamma]L"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Delta]L", ",", "0", ",", "\[Delta]Lmax"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Delta]M", ",", 
         RowBox[{"-", "\[Delta]L"}], ",", "\[Delta]L"}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]"}]}]], "Input",
