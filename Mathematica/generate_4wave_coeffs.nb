        RowBox[{
         RowBox[{
          RowBox[{"P", "[", 
           RowBox[{"k", ",", "n", ",", "m"}], "]"}], 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"-", "1"}], ")"}], "^", 
           RowBox[{"(", 
            RowBox[{"-", "k"}], ")"}]}], " ", 
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"1", "-", "k", "-", 
            RowBox[{"2", "I", " ", "q"}], " ", "-", 
            RowBox[{"2", 
             RowBox[{"sN00", "[", "n", "]"}]}], "-", 
            RowBox[{"2", 
             RowBox[{"sN00", "[", "m", "]"}]}]}], "]"}], 
          RowBox[{"\[CapitalGamma]", "[", 
           RowBox[{"k", "+", 
            RowBox[{"sN00", "[", "n", "]"}], "+", 
            RowBox[{"sN00", "[", "m", "]"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{"n", "+", "m"}]}], "}"}]}], "]"}]}], "+", 
      RowBox[{"2", " ", "I", " ", "q", 
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], 
