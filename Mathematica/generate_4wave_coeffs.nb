   RowBox[{
    SuperscriptBox["rp", "2"], " ", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"-", "1"}], ")"}], "^", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"sN00", "[", "n", "]"}]}], "-", 
        RowBox[{"sN00", "[", "m", "]"}]}], ")"}]}], 
     RowBox[{"\[CapitalGamma]", "[", 
      RowBox[{"1", "-", 
       RowBox[{"2", " ", "I", " ", "q"}], "-", 
       RowBox[{"sN00", "[", "n", "]"}], "-", 
       RowBox[{"sN00", "[", "m", "]"}]}], "]"}]], 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
