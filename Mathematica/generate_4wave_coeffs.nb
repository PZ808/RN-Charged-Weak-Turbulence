Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"GenerateSassoc", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]Nmax_", ",", "\[Alpha]Lmax_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]Nmax_", ",", "\[Beta]Lmax_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]Nmax_", ",", "\[Gamma]Lmax_"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]Nmax_", ",", "\[Delta]Lmax_"}], "}"}]}], "]"}], ":=", 
    
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "currentIndices", ",", "symmetricEquivalents", ",", 
          "foundEquivalent", ",", "value"}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{"Current", " ", "indices"}], "*)"}], 
        RowBox[{
         RowBox[{"currentIndices", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Alpha]N", ",", "\[Alpha]L", ",", "\[Alpha]M"}], "}"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"\[Beta]N", ",", "\[Beta]L", ",", "\[Beta]M"}], "}"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{"\[Gamma]N", ",", "\[Gamma]L", ",", "\[Gamma]M"}], "}"}],
             ",", 
            RowBox[{"{", 
             RowBox[{"\[Delta]N", ",", "\[Delta]L", ",", "\[Delta]M"}], 
             "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "Should", " ", "we", " ", "also", " ", "check", " ", "if", " ", 
            SubscriptBox["Q", 
             RowBox[{"1234", " "}]]}], "=", " ", 
           RowBox[{"0", " ", "in", " ", "which", " ", "case", " ", 
            RowBox[{"there", "'"}], "se", " ", "no", " ", "point", " ", "in", 
            " ", "computing", " ", "it", " ", "wrt", " ", "to", " ", "the", 
            " ", "full", " ", "bilinear", " ", "form"}]}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Generate", " ", "all", " ", "symmetric", " ", "equivalents"}], 
          "*)"}], 
         RowBox[{"symmetricEquivalents", "=", 
          RowBox[{
          "GenerateSymmetricEquivalentsS", "[", "currentIndices", "]"}]}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Check", " ", "if", " ", "any", " ", "symmetric", " ", "equivalent",
            " ", "is", " ", "already", " ", "computed"}], "*)"}], 
         RowBox[{"foundEquivalent", "=", 
          RowBox[{"SelectFirst", "[", 
           RowBox[{"symmetricEquivalents", ",", 
            RowBox[{
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"precomputedS1b234", ",", "#"}], "]"}], "&"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"foundEquivalent", "=!=", 
            RowBox[{"Missing", "[", "\"\<NotFound\>\"", "]"}]}], ",", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "If", " ", "an", " ", "equivalent", " ", "is", " ", "found"}], 
             ",", 
             RowBox[{"copy", " ", "its", " ", "value"}]}], "*)"}], 
           RowBox[{
            RowBox[{"precomputedS1b234", "[", "currentIndices", "]"}], "=", 
            RowBox[{"precomputedS1b234", "[", "foundEquivalent", "]"}]}], ",", 
           RowBox[{"(*", 
            RowBox[{"Otherwise", ",", 
             RowBox[{
             "compute", " ", "and", " ", "store", " ", "the", " ", 
              "value"}]}], "*)"}], 
           RowBox[{
            RowBox[{"precomputedS1b234", "[", "currentIndices", "]"}], "=", 
            RowBox[{"computeSNLM4", "@@", "currentIndices"}]}]}], "]"}], 
         ";"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]N", ",", "0", ",", "\[Alpha]Nmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]L", ",", "0", ",", "\[Alpha]Lmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Alpha]M", ",", 
        RowBox[{"-", "\[Alpha]L"}], ",", "\[Alpha]L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]N", ",", "0", ",", "\[Beta]Nmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]L", ",", "0", ",", "\[Beta]Lmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Beta]M", ",", 
        RowBox[{"-", "\[Beta]L"}], ",", "\[Beta]L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]N", ",", "0", ",", "\[Gamma]Nmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]L", ",", "0", ",", "\[Gamma]Lmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]M", ",", 
        RowBox[{"-", "\[Gamma]L"}], ",", "\[Gamma]L"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]N", ",", "0", ",", "\[Delta]Nmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]L", ",", "0", ",", "\[Delta]Lmax"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Delta]M", ",", 
        RowBox[{"-", "\[Delta]L"}], ",", "\[Delta]L"}], "}"}]}], "]"}]}], 
