             RowBox[{"\[Lambda]", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "+", "1"}], ")"}]}], "-", 
          SuperscriptBox["q", "2"]}], "]"}]}]}], "}"}], ",", 
     FractionBox[
      RowBox[{
       RowBox[{"Pochhammer", "[", 
