  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GenLegend", "[", "alist_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"labels", ",", "colors", ",", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "alist", "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"labels", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p", ",", "l", ",", "m"}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"p", ",", "l", ",", "m"}], "}"}], "=", 
             RowBox[{"First", "@", 
              RowBox[{"Head", "@", 
               RowBox[{"alist", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"\"\<n=\>\"", "<>", 
