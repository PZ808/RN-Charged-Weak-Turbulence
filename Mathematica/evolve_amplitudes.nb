Cell[CellGroupData[{
Cell["4-wave interaction amplitude evolutions", "Title",
 CellChangeTimes->{{3.954649801518691*^9, 3.954649813360386*^9}, {
  3.954928758893592*^9, 
  3.9549287818371677`*^9}},ExpressionUUID->"e1947304-9a4a-4f23-8bcb-\
3f9d9918b3f2"],

Cell["\<\
Evolves the systems of coupled oscillators for QNMs in the near horizon \
geometry of RN with asymptotically small but finite Hawking temperature. This \
is the poincare patch  \[OpenCurlyDoubleQuote]\[Kappa]-AdS2\
\[CloseCurlyDoubleQuote] with a constant electric field (NHERN)\
\>", "Text",
 CellChangeTimes->{{3.954649815508967*^9, 
  3.9546499306582117`*^9}},ExpressionUUID->"5cec2235-6153-4f14-aa83-\
23bd08dea87a"],

