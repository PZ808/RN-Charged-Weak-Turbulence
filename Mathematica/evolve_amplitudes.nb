             RowBox[{"ToString", "[", "m", "]"}]}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"colors", "=", 
       RowBox[{"GetColors1", "[", "n", "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"use", " ", "either", " ", "method", " ", "above"}], "*)"}], 
      RowBox[{"Placed", "[", 
       RowBox[{
        RowBox[{"LineLegend", "[", 
         RowBox[{"colors", ",", "labels"}], "]"}], ",", "Right"}], "]"}]}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\n", 
